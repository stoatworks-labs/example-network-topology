## rclone remote definition for one VMix PC's SMB share.
## Generated per-PC by generate-rclone-conf.sh — do not hand-edit, edit this
## template and re-run the generator instead.
##
## rclone requires an "obscured" password, not plaintext — generate it with:
##   rclone obscure 'the-real-password'
## and paste the output below (or pass an env var instead of writing it to disk at all).
##
## SMB shares are named, not just host+path like FTP — the share name isn't part of
## this config block, it's given at use time (rclone mount vmix-node1-pc1:ShareName ...,
## set via VMIX_SHARE_NAME in mount-and-sync.sh). Confirm the real share name against
## the actual machine (e.g. whatever New-SmbShare created) — not assumed here.

[vmix-node__NODE__-pc__PC__]
type = smb
host = 192.168.__X__.__PCOCTET__
user = REPLACE_WITH_SMB_USER
pass = REPLACE_WITH_OBSCURED_PASSWORD
