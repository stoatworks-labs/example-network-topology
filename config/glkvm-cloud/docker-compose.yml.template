# Self-hosted GLKVM-Cloud on the consolidated services server (Unraid).
# See docs/glkvm-cloud.md for the full design rationale and the WAN port-forward mapping
# (config/unifi/network-config.yaml) needed to avoid colliding with the DERP server's
# WAN 443/tcp + 3478/udp forwards.
#
# Upstream reference (confirm against the current version before deploying):
# https://github.com/gl-inet/glkvm-cloud/blob/main/docker-compose/docker-compose.yml
#
# Every service here gets its own macvlan IP, same pattern as every other container on
# this box — swap MACVLAN_PARENT/MACVLAN_SUBNET for this box's actual values. No
# `ports:` mapping is used below: macvlan containers have a real L3 address on the
# physical network already, so Docker's host-side port-publishing doesn't apply — each
# service is reachable directly at its own IP on whatever ports it natively listens on.

networks:
  macvlan-mothership:
    driver: macvlan
    driver_opts:
      parent: MACVLAN_PARENT   # e.g. eth0 / bond0
    ipam:
      config:
        - subnet: 192.168.1.0/24
          gateway: 192.168.1.1

services:
  # The image's entrypoint is bare /usr/bin/rttys with no config — the RTTYS_*/TURN_*
  # variables below are only read by upstream's docker-entrypoint.sh, which renders the
  # rttys/coturn config templates. So, as upstream does, both services mount those files
  # from a checkout of https://github.com/gl-inet/glkvm-cloud (replace UPSTREAM_DIR with
  # its path, e.g. /mnt/user/appdata/glkvm-cloud/upstream).
  rttys:
    image: glzhitong/glkvm-cloud:latest
    container_name: glkvm-cloud
    restart: unless-stopped
    networks:
      macvlan-mothership:
        ipv4_address: 192.168.1.20
    environment:
      # Written into rttys's webrtc-ip and coturn's external-ip, and upstream's own
      # auto-detect only accepts IPv4 — so the venue's PUBLIC IPv4, not kvm.example.net.
      GLKVM_ACCESS_IP: "REPLACE_WITH_PUBLIC_IPV4"
      RTTYS_TOKEN: "REPLACE_ME"
      RTTYS_PASS: "REPLACE_ME"
      RTTYS_DEVICE_PORT: "5912"
      RTTYS_WEBUI_PORT: "443"
      RTTYS_HTTP_PROXY_PORT: "10443"
      # The TURN port rttys advertises to browsers: the WAN-side 3479 (DERP holds 3478).
      TURN_PORT: "3479"
      TURN_USER: "REPLACE_ME"
      TURN_PASS: "REPLACE_ME"
    entrypoint: ["/bin/sh", "/docker-entrypoint.sh"]
    command: ["rttys"]
    volumes:
      - UPSTREAM_DIR/docker-compose/templates/rttys.conf.template:/tpl/rttys.conf.tmpl:ro
      - UPSTREAM_DIR/docker-compose/scripts/docker-entrypoint.sh:/docker-entrypoint.sh:ro
      - UPSTREAM_DIR/docker-compose/certificate/glkvm.cer:/home/certificate/glkvm_cer:ro
      - UPSTREAM_DIR/docker-compose/certificate/glkvm.key:/home/certificate/glkvm_key:ro
      - /mnt/user/appdata/glkvm-cloud/database:/home/database

  coturn:
    image: coturn/coturn:edge-alpine
    container_name: glkvm-coturn
    restart: unless-stopped
    user: "0:0"   # as upstream — needs to read the bind-mounted entrypoint
    networks:
      macvlan-mothership:
        ipv4_address: 192.168.1.22
    environment:
      GLKVM_ACCESS_IP: "REPLACE_WITH_PUBLIC_IPV4"   # same value as rttys
      TURN_PORT: "3478"                             # what coturn listens on; WAN 3479 forwards here
      TURN_USER: "REPLACE_ME"                       # match rttys
      TURN_PASS: "REPLACE_ME"                       # match rttys
    entrypoint: ["/bin/sh", "/docker-entrypoint.sh"]
    command: ["coturn"]
    volumes:
      - UPSTREAM_DIR/docker-compose/templates/turnserver.conf.template:/tpl/turnserver.conf.tmpl:ro
      - UPSTREAM_DIR/docker-compose/scripts/docker-entrypoint.sh:/docker-entrypoint.sh:ro
