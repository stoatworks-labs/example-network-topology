# GL-iNet A-1300 — Theatre 1 — 192.168.2.0/24
#
# Generated from theatre-network.uci.template — do not hand-edit, edit the template
# and re-run generate-configs.sh instead.
#
# Covers /etc/config/network and /etc/config/dhcp only. See README.md for what's
# NOT covered (Wi-Fi, Tailscale, VPN policy) and how to apply this.

# ---- /etc/config/network ----------------------------------------------

config interface 'lan'
	option type 'bridge'
	option ifname 'lan1 lan2'
	option proto 'static'
	option ipaddr '192.168.2.1'
	option netmask '255.255.255.0'
	# LAN 1 -> ATEM Mini Extreme ISO (direct). LAN 2 -> Netgear 8-port switch
	# (everything else, including BirdDog Play). Both bridged into one LAN —
	# this is a physical port split for traffic separation, not a subnet
	# split. See docs/topology.md.

config interface 'wan'
	option ifname 'wan'
	option proto 'dhcp'
	# Uplinks to the mothership's Cloud Gateway via this theatre's VLAN group.
	# WAN address doesn't need to be static/predictable — Tailscale rides over
	# whatever it gets. See docs/ip-address-map.md for the uplink VLAN this
	# theatre lands on.

# ---- /etc/config/dhcp ---------------------------------------------------

config dhcp 'lan'
	option interface 'lan'
	option start '100'
	option limit '50'
	option leasetime '12h'
	# Dynamic range (192.168.2.100-149) for anything not listed as a static
	# lease below — e.g. a technician's laptop joining temporarily.

# Static leases — fixed IPs per docs/ip-address-map.md. Replace every
# REPLACE_WITH_MAC_nn with that device's real MAC address before applying.

config host
	option name 'birddog-play'
	option mac 'REPLACE_WITH_MAC_01'
	option ip '192.168.2.20'

config host
	option name 'atem-mini-extreme-iso'
	option mac 'REPLACE_WITH_MAC_02'
	option ip '192.168.2.2'

config host
	option name 'powerpoint-main'
	option mac 'REPLACE_WITH_MAC_03'
	option ip '192.168.2.5'

config host
	option name 'powerpoint-backup'
	option mac 'REPLACE_WITH_MAC_04'
	option ip '192.168.2.6'

config host
	option name 'vt-main'
	option mac 'REPLACE_WITH_MAC_05'
	option ip '192.168.2.7'

config host
	option name 'vt-backup'
	option mac 'REPLACE_WITH_MAC_06'
	option ip '192.168.2.8'

config host
	option name 'control-laptop'
	option mac 'REPLACE_WITH_MAC_07'
	option ip '192.168.2.10'
