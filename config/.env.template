# Copy to .env (same directory as docker-compose.yml) and replace every value below.
# .env is gitignored on purpose — never commit real credentials.

# --- Networking ---
# The Unraid box's bonded interface — likely `bond0` per docs/topology.md's LACP setup,
# but confirm the actual name on this box before deploying.
MACVLAN_PARENT=REPLACE_ME_bond0

# --- Nextcloud ---
NEXTCLOUD_DB_ROOT_PASSWORD=REPLACE_ME
NEXTCLOUD_DB_PASSWORD=REPLACE_ME
NEXTCLOUD_ADMIN_USER=REPLACE_ME
NEXTCLOUD_ADMIN_PASSWORD=REPLACE_ME

# --- Restreamer ---
RESTREAMER_USERNAME=REPLACE_ME
RESTREAMER_PASSWORD=REPLACE_ME

# --- ATEM ISO Ingest --- confirm against a real unit, see docs/atem-iso-ingest.md
ATEM_FTP_USER=REPLACE_ME
ATEM_FTP_PASS=REPLACE_ME
ATEM_FTP_REMOTE_DIR=/
# ISO inputs pulled live, per the common theatre input map (program is always pulled).
# 1 = camera. Add 2 / 3 for the presenter laptops if the router has room.
ATEM_ISO_INPUTS=1
# Per-theatre override, e.g. Theatre 3 also pulls its main laptop live:
# ATEM_ISO_INPUTS_T3=1,2      (empty = use the default; 0 = program only)

# --- VMix Record Ingest --- confirm against the real PCs, see docs/vmix-record-ingest.md
VMIX_SHARE_NAME=REPLACE_WITH_SHARE_NAME

# --- UniFi Controller ---
UNIFI_DB_ROOT_USER=REPLACE_ME
UNIFI_DB_ROOT_PASSWORD=REPLACE_ME

# --- GLKVM-Cloud --- see docs/glkvm-cloud.md
# The venue's PUBLIC IPv4 (becomes rttys's webrtc-ip and coturn's external-ip) — not the
# kvm.example.net hostname.
GLKVM_ACCESS_IP=REPLACE_WITH_PUBLIC_IPV4
GLKVM_RTTYS_TOKEN=REPLACE_ME
GLKVM_RTTYS_PASS=REPLACE_ME
GLKVM_TURN_USER=REPLACE_ME
GLKVM_TURN_PASS=REPLACE_ME
# Optional: where the upstream glkvm-cloud checkout lives (entrypoint + templates)
# GLKVM_UPSTREAM=/mnt/user/appdata/glkvm-cloud/upstream

# --- ATEM Overseer / Flock --- optional, both have working defaults in docker-compose.yml
# ATEM_OVERSEER_PORT=8090
# FLOCK_PREVIEW_PORT=9090

# --- Tailscale subnet router ---
# A reusable auth key from the tailnet admin console, pre-tagged tag:mothership (not
# ephemeral — the subnet router must survive restarts) —
# see config/tailscale-up-all-devices.sh for how the other 14 nodes authenticate.
TAILSCALE_AUTHKEY=REPLACE_ME
